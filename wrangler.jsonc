{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gas-fee-optimizer",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "GasScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GasScheduler"
      ]
    }
  ]
}
